<?xml version="1.0" encoding="utf-8"?>
<!--
  [灰度定制] 窗口背景：代替原来的 app_bg.jpg（一张 1280x720 的照片）。
  这个文件由 apply-patch.sh 拷进 app/src/main/res/drawable/ 并删掉同名 .jpg
  —— 同名资源共存会让 aapt2 报 duplicate resource，所以必须删旧的。

  想改配色就改下面两个色值：
    - 深灰底（与深色 UI 面板 #1E1E1E 形成层次）＝ #FF1A1A1A → #FF101010（当前）
    - 纯色灰底：把 <gradient> 换成 <solid android:color="#FF1A1A1A" />
    - 浅灰底：换成 #FF808080 之类（注意：白字在浅灰上会不好读，需一并调文字色）
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FF1A1A1A"
        android:endColor="#FF101010"
        android:type="linear" />
</shape>
